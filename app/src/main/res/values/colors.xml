<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Only the splash window needs a colour resource — everything else is themed
      in Compose from ui/theme/Color.kt. Keep this in sync with backgroundLight,
      and the values-night copy with backgroundDark, so the splash hands over to
      the page base without a flash.
    -->
    <color name="splash_background">#FBF6EE</color>

    <!--
      The star in ic_splash_icon.xml. It has to sit legibly on splash_background,
      so it flips per mode exactly like AppColors.brandAccent does: BrandTealLight
      here, cream in the values-night copy. The yellow centre dot stays AccentYellow
      in both modes — it is a fill, not ink.
    -->
    <color name="splash_icon_star">#0F5B66</color>
</resources>
