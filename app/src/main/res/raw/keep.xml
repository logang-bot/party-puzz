<?xml version="1.0" encoding="utf-8"?>
<!-- Resources loaded by name, which neither lint nor the resource shrinker can see being used:
     - the random avatars (getIdentifier)
     - aboutlibraries.json, which AboutLibraries reads for Settings → Open-source licenses -->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@drawable/img_dummy_avatar_*,@raw/aboutlibraries" />
